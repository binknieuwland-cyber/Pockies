// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COMM_POCKIES
  HUISGENOOT
}

enum PaymentStatus {
  NOG_NIET_GESTUURD
  TIKKIE_GESTUURD
  BETAALD
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  codeHash  String
  role      Role
  personId  Int?     @unique
  person    Person?  @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
}

model Section {
  id      Int      @id @default(autoincrement())
  name    String
  persons Person[]
  groups  Group[]
}

model Group {
  id        Int     @id @default(autoincrement())
  name      String
  sortOrder Int     @default(0)
  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  persons   Person[]
}

model Person {
  id            Int           @id @default(autoincrement())
  name          String
  fullName      String?
  sortOrder     Int           @default(0)
  locked        Boolean       @default(false)
  sectionId     Int
  section       Section       @relation(fields: [sectionId], references: [id])
  groupId       Int?
  group         Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  orders        Order[]
  user          User?
  phone         String?
  paymentStatus PaymentStatus @default(NOG_NIET_GESTUURD)
  referredById  Int?
  referredBy    Person?       @relation("PersonReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     Person[]      @relation("PersonReferral")
}

model Product {
  id           Int     @id @default(autoincrement())
  name         String
  priceExclBtw Decimal @db.Decimal(10, 2)
  orders       Order[]
}

model Order {
  id        Int      @id @default(autoincrement())
  personId  Int
  productId Int
  size      String   // S, M, L, XL
  quantity  Int      @default(1)
  note      String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}
