# Copy this file to .env and fill in your values
# For local development, use a local PostgreSQL connection string
# For production on Vercel + Neon, use the Neon connection string

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Gedeelde toegangscode voor huisgenoten login (naast e-mail)
HUISGENOOT_ACCESS_CODE="verander-mij"
